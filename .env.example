# Copy this file to .env and fill in the values. Never commit .env.

# --- AI provider: gemini | ollama | rules (rules = offline keyword mode, for testing only)
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash
# Tried in order when the main model is overloaded or rate limited
AI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.8-flash
AI_API_KEY=paste-your-gemini-key-here
# Only used when AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434

# --- Email provider: mock | outlook
EMAIL_PROVIDER=mock
# Azure app registration (Application / client ID). Only needed for outlook.
MS_CLIENT_ID=
# The POC Outlook address the agent works from (used to ignore our own emails)
MY_EMAIL_ADDRESS=optimization.poc@outlook.com
